# Banco de dados (SQLite local). Para PostgreSQL, altere o provider em prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Segredo para assinar as sessões (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# URL pública do site (usada em SEO, sitemap e links de recuperação de senha)
SITE_URL="http://localhost:3000"

# SMTP para envio do e-mail de recuperação de senha (opcional em desenvolvimento:
# sem SMTP, o link é exibido no console do servidor)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
